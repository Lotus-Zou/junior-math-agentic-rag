# OpenAI-compatible Responses endpoint
MODEL_PROVIDER="custom"
MODEL_WIRE_API="responses"
MODEL_REASONING_EFFORT="low"
DISABLE_RESPONSE_STORAGE="true"
OPENAI_API_KEY=""
OPENAI_API_BASE="https://api.ai.tosky.top"
LLM_MODEL_NAME="gpt-5.6-sol"
CRITIC_MODEL_NAME="gpt-5.6-sol"
RERANK_MODEL_NAME="gpt-5.6-sol"

# Dense mathematics embedding; replace with your deployed bge-math model when available
EMBEDDING_PROVIDER="local"
EMBEDDING_API_BASE=
EMBEDDING_MODEL_NAME="text-embedding-3-small"
MATH_EMBEDDING_MODEL_PATH="BAAI/bge-m3"

CHROMA_PATH="chroma_db"
ENABLE_DENSE_RETRIEVAL=true
TAVILY_API_KEY=""
TAVILY_API_BASE="https://api.tavily.com/search"
TAVILY_MAX_RESULTS=5
TAVILY_TIMEOUT_SECONDS=10
TAVILY_INCLUDE_DOMAINS=""
KNOWLEDGE_GRAPH_PATH="data/knowledge_graph.json"
TRACE_PATH="traces"
RETRIEVAL_CANDIDATES=24
RETRIEVAL_TOP_K=6
RERANK_TOP_K=6
MAX_CORRECTION_ATTEMPTS=2
MAX_AGENT_STEPS=24
MAX_REACT_STEPS=8
RUN_TIMEOUT_SECONDS=240
LLM_CALL_TIMEOUT_SECONDS=45
EXERCISE_LLM_CALL_TIMEOUT_SECONDS=45
ENABLE_EXERCISE_AGENT=true
ENABLE_TUTOR_AGENT=true
FORCE_LLM_EVERY_TURN=true
ATTACHMENT_LLM_CALL_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
MAX_HISTORY_MESSAGES=12

REDIS_URL="redis://redis:6379/0"
CACHE_TTL_SECONDS=3600
OPERATIONS_METRICS_TOKEN=""

MIN_CONTEXT_PRECISION=0.65
MIN_CONTEXT_RECALL=0.70
MIN_FAITHFULNESS=0.75
MIN_ANSWER_RELEVANCE=0.70
MIN_KNOWLEDGE_POINT_ACCURACY=0.80
MAX_DIRECT_ANSWER_VIOLATION_RATE=0.05

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="junior-math-agentic-rag"
